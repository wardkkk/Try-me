
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Segoe UI', Arial, sans-serif; background: transparent; color: var(--color-text-primary); direction: rtl; }
.header { padding: 1.25rem 1.5rem 1rem; border-bottom: 0.5px solid var(--color-border-tertiary); display: flex; align-items: center; gap: 10px; }
.logo-icon { width: 34px; height: 34px; background: #1a5fd4; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.logo-icon svg { width: 19px; height: 19px; fill: white; }
.logo-text { font-size: 17px; font-weight: 500; }
.stats { display: flex; gap: 10px; padding: 1rem 1.5rem; }
.stat { background: var(--color-background-secondary); border-radius: var(--border-radius-md); padding: 0.65rem 1rem; flex: 1; }
.stat-label { font-size: 11px; color: var(--color-text-secondary); margin-bottom: 3px; }
.stat-value { font-size: 19px; font-weight: 500; }
.drop-zone { margin: 0 1.5rem 1rem; border: 1.5px dashed var(--color-border-secondary); border-radius: var(--border-radius-lg); padding: 1.75rem 1rem; text-align: center; cursor: pointer; transition: all 0.2s; }
.drop-zone:hover, .drop-zone.drag { background: var(--color-background-secondary); border-color: #1a5fd4; }
.drop-icon { width: 42px; height: 42px; margin: 0 auto 0.6rem; background: #e6f1fb; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.drop-icon svg { width: 21px; height: 21px; fill: #1a5fd4; }
.drop-title { font-size: 14px; font-weight: 500; }
.drop-sub { font-size: 12px; color: var(--color-text-secondary); margin-top: 3px; }
.files-wrap { padding: 0 1.5rem 1.5rem; }
.sec-title { font-size: 12px; font-weight: 500; color: var(--color-text-secondary); letter-spacing: 0.4px; text-transform: uppercase; margin-bottom: 8px; }
.file-row { background: var(--color-background-primary); border: 0.5px solid var(--color-border-tertiary); border-radius: var(--border-radius-lg); padding: 0.8rem 1rem; margin-bottom: 6px; display: flex; align-items: center; gap: 10px; }
.f-icon { width: 36px; height: 36px; background: #1a5fd4; border-radius: 7px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.f-icon svg { width: 18px; height: 18px; fill: white; }
.f-info { flex: 1; min-width: 0; }
.f-name { font-size: 13px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.f-meta { font-size: 11px; color: var(--color-text-secondary); margin-top: 2px; }
.f-btns { display: flex; gap: 5px; }
.ibtn { width: 30px; height: 30px; border: 0.5px solid var(--color-border-secondary); border-radius: 7px; background: transparent; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.15s; }
.ibtn:hover { background: var(--color-background-secondary); }
.ibtn svg { width: 14px; height: 14px; fill: var(--color-text-secondary); }
.ibtn.del:hover { background: #fcebeb; border-color: #e24b4a; }
.ibtn.del:hover svg { fill: #e24b4a; }
.empty-state { text-align: center; padding: 1.5rem; color: var(--color-text-secondary); font-size: 13px; }
.toast { position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%); padding: 8px 18px; border-radius: 20px; font-size: 13px; opacity: 0; transition: opacity 0.3s; pointer-events: none; z-index: 999; white-space: nowrap; }
.toast.ok { background: #1d9e75; color: white; }
.toast.err { background: #e24b4a; color: white; }
.toast.show { opacity: 1; }
.progress-bar { height: 3px; background: var(--color-border-tertiary); border-radius: 2px; margin: 0 1.5rem 0.75rem; overflow: hidden; display: none; }
.progress-fill { height: 100%; background: #1a5fd4; border-radius: 2px; width: 0%; transition: width 0.3s; }
#fi { display: none; }
</style>

<div class="header">
  <div class="logo-icon">
    <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6zm-1 1.5L18.5 9H13V3.5zM6 20V4h5v7h7v9H6z"/></svg>
  </div>
  <span class="logo-text">مخزن ملفات Word</span>
</div>

<div class="stats">
  <div class="stat"><div class="stat-label">الملفات</div><div class="stat-value" id="cnt">0</div></div>
  <div class="stat"><div class="stat-label">الحجم الكلي</div><div class="stat-value" id="sz">—</div></div>
</div>

<div class="drop-zone" id="dz" onclick="document.getElementById('fi').click()">
  <div class="drop-icon">
    <svg viewBox="0 0 24 24"><path d="M19.35 10.04A7.49 7.49 0 0012 4C9.11 4 6.6 5.64 5.35 8.04A5.994 5.994 0 000 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/></svg>
  </div>
  <div class="drop-title">اسحب ملف Word هنا أو اضغط للاختيار</div>
  <div class="drop-sub">.docx · .doc — الحد الأقصى 3 MB للملف</div>
</div>
<input type="file" id="fi" accept=".docx,.doc,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" multiple>

<div class="progress-bar" id="pb"><div class="progress-fill" id="pf"></div></div>

<div class="files-wrap">
  <div class="sec-title">الملفات المحفوظة</div>
  <div id="list"></div>
</div>

<div class="toast" id="toast"></div>

<script>
const PREF = 'wf_';
const MAX_BYTES = 3 * 1024 * 1024;

function toast(msg, type='ok') {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = 'toast ' + type + ' show';
  clearTimeout(el._t);
  el._t = setTimeout(() => el.classList.remove('show'), 3000);
}

function fmtSize(b) {
  if (!b) return '—';
  if (b < 1024) return b + ' B';
  if (b < 1048576) return (b/1024).toFixed(1) + ' KB';
  return (b/1048576).toFixed(1) + ' MB';
}

function fmtDate(ts) {
  return new Date(ts).toLocaleDateString('ar-AE', { day:'numeric', month:'short', year:'numeric' });
}

function safeKey(name) {
  return PREF + Date.now() + '_' + name.replace(/[^\w.]/g, '_').slice(0, 60);
}

async function load() {
  const listEl = document.getElementById('list');
  listEl.innerHTML = '';
  let count = 0, totalSize = 0;
  try {
    const res = await window.storage.list(PREF);
    const keys = res && res.keys ? res.keys : [];
    count = keys.length;
    if (!keys.length) {
      listEl.innerHTML = '<div class="empty-state">لا توجد ملفات محفوظة بعد</div>';
    } else {
      for (const k of keys) {
        try {
          const r = await window.storage.get(k);
          if (!r) continue;
          const f = JSON.parse(r.value);
          totalSize += f.size || 0;
          const row = document.createElement('div');
          row.className = 'file-row';
          row.innerHTML = `
            <div class="f-icon"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6zm-1 1.5L18.5 9H13V3.5zM6 20V4h5v7h7v9H6z"/></svg></div>
            <div class="f-info">
              <div class="f-name">${f.name}</div>
              <div class="f-meta">${fmtSize(f.size)} · ${fmtDate(f.date)}</div>
            </div>
            <div class="f-btns">
              <button class="ibtn" title="تحميل" onclick="dl('${k}')">
                <svg viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zm-8 2V5h2v6h1.17L12 13.17 9.83 11H11zm-6 8h14v2H5v-2z"/></svg>
              </button>
              <button class="ibtn del" title="حذف" onclick="del('${k}')">
                <svg viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
              </button>
            </div>`;
          listEl.appendChild(row);
        } catch(e) {}
      }
    }
  } catch(e) {
    listEl.innerHTML = '<div class="empty-state">تعذر تحميل القائمة</div>';
  }
  document.getElementById('cnt').textContent = count;
  document.getElementById('sz').textContent = fmtSize(totalSize);
}

async function save(file) {
  if (file.size > MAX_BYTES) {
    toast('الملف أكبر من 3 MB: ' + file.name, 'err');
    return false;
  }
  return new Promise((resolve) => {
    const reader = new FileReader();
    reader.onload = async (e) => {
      try {
        const b64 = e.target.result.split(',')[1];
        if (!b64) throw new Error('empty');
        const key = safeKey(file.name);
        const val = JSON.stringify({ name: file.name, size: file.size, date: Date.now(), data: b64, mime: file.type });
        await window.storage.set(key, val);
        resolve(true);
      } catch(err) {
        console.error(err);
        toast('فشل حفظ: ' + file.name, 'err');
        resolve(false);
      }
    };
    reader.onerror = () => { toast('خطأ في قراءة الملف', 'err'); resolve(false); };
    reader.readAsDataURL(file);
  });
}

async function dl(key) {
  try {
    const r = await window.storage.get(key);
    if (!r) { toast('الملف غير موجود', 'err'); return; }
    const f = JSON.parse(r.value);
    const bytes = Uint8Array.from(atob(f.data), c => c.charCodeAt(0));
    const mime = f.mime || 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
    const blob = new Blob([bytes], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = f.name; a.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    toast('تم التحميل بنجاح');
  } catch(e) { toast('خطأ في التحميل', 'err'); }
}

async function del(key) {
  try {
    await window.storage.delete(key);
    toast('تم الحذف');
    load();
  } catch(e) { toast('خطأ في الحذف', 'err'); }
}

async function handleFiles(files) {
  const wordFiles = files.filter(f => /\.(docx?|doc)$/i.test(f.name) || f.type.includes('word') || f.type.includes('msword'));
  if (!wordFiles.length) { toast('يُقبل فقط ملفات .docx أو .doc', 'err'); return; }
  
  const pb = document.getElementById('pb');
  const pf = document.getElementById('pf');
  pb.style.display = 'block';
  
  let ok = 0;
  for (let i = 0; i < wordFiles.length; i++) {
    pf.style.width = ((i / wordFiles.length) * 100) + '%';
    const res = await save(wordFiles[i]);
    if (res) ok++;
  }
  pf.style.width = '100%';
  setTimeout(() => { pb.style.display = 'none'; pf.style.width = '0%'; }, 600);
  
  if (ok > 0) toast(ok === 1 ? 'تم رفع الملف بنجاح ✓' : `تم رفع ${ok} ملفات ✓`);
  load();
}

document.getElementById('fi').addEventListener('change', async (e) => {
  await handleFiles(Array.from(e.target.files));
  e.target.value = '';
});

const dz = document.getElementById('dz');
dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('drag'); });
dz.addEventListener('dragleave', () => dz.classList.remove('drag'));
dz.addEventListener('drop', async (e) => {
  e.preventDefault(); dz.classList.remove('drag');
  await handleFiles(Array.from(e.dataTransfer.files));
});

load();
</script>
